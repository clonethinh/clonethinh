#!/bin/sh

# Hàm làm sạch chuỗi cho JSON
json_safe() {
  echo "$1" | tr -d '\000-\037' | sed 's/"/\\"/g'
}

# Thu thập dữ liệu từ modem
O=$(sms_tool -d "$DEVICE" at "at!gstatus?")

# Nhiệt độ
T=$(echo "$O" | awk -F: '/Temperature:/ {print $3}')
[ -n "$T" ] && TEMP="$T °C"

# Chế độ kết nối
T=$(echo "$O" | awk '/^System mode:/ {print $3}')
case "$T" in
  "LTE") MODE="LTE" ;;
  "ENDC") MODE="5G NSA" ;;
esac

# TAC
T=$(echo "$O" | awk '/.*TAC:/ {print $6}')
if [ -n "$T" ]; then
  T_DEC=$(printf "%d" "0x$T")
  T_HEX=$T
fi

# Chỉ số sóng chính
T=$(echo "$O" | awk '/^PCC.*RSSI/ {print $4}' | xargs)
[ -n "$T" ] && RSSI="${T// /}"
T=$(echo "$O" | awk '/^PCC.*RSRP/ {print $8}' | xargs)
[ -n "$T" ] && RSRP="${T// /}"
T=$(echo "$O" | awk '/^RSRQ/ {print $3}')
[ -n "$T" ] && RSRQ="$T"
T=$(echo "$O" | awk '/^SINR/ {print $3}')
[ -n "$T" ] && SINR="$T"

# Băng tần LTE chính
T=$(echo "$O" | awk '/^LTE band:/ {print $3}')
if [ -n "$T" ]; then
  T1=$(echo "$O" | awk '/^LTE band:/ {print $6}')
  PBAND="$(band4g ${T/B/}) @${T1} MHz"
  MODE="$MODE $(band4g ${T/B/})"
fi

# LTE SCC1
T=$(echo "$O" | awk -F: '/^LTE SCC1 state:.*ACTIVE/ {print $3}')
if [ -n "$T" ]; then
  T1=$(echo "$O" | awk '/^LTE SCC1 bw/ {print $5}')
  [ -n "$T1" ] && S1BAND="$(band4g ${T/B/}) @${T1} MHz" || S1BAND="$(band4g ${T/B/})"
  MODE="${MODE/LTE/LTE_A} / $(band4g ${T/B/})"
fi

# LTE SCC2
T=$(echo "$O" | awk -F: '/^LTE SCC2 state:.*ACTIVE/ {print $3}')
if [ -n "$T" ]; then
  T1=$(echo "$O" | awk '/^LTE SCC2 bw/ {print $5}')
  [ -n "$T1" ] && S2BAND="$(band4g ${T/B/}) @${T1} MHz" || S2BAND="$(band4g ${T/B/})"
  MODE="$MODE / $(band4g ${T/B/})"
fi

# LTE SCC3
T=$(echo "$O" | awk -F: '/^LTE SCC3 state:.*ACTIVE/ {print $3}')
if [ -n "$T" ]; then
  T1=$(echo "$O" | awk '/^LTE SCC3 bw/ {print $5}')
  [ -n "$T1" ] && S3BAND="$(band4g ${T/B/}) @${T1} MHz" || S3BAND="$(band4g ${T/B/})"
  MODE="$MODE / $(band4g ${T/B/})"
fi

# NR5G band
T=$(echo "$O" | awk '/^SCC. NR5G band:/ {print $4}')
if [ -n "$T" ] && [ "$T" != "---" ]; then
  MODE="$MODE / $(band5g ${T/n/})"
fi

# Format lại MODE
MODE=$(echo "$MODE" | sed "s/LTE_A/LTE-A |/g" | sed 's,/,+,g')

# Giao thức kết nối USB
PV=$(cat /sys/kernel/debug/usb/devices)
PVCUT=$(echo "$PV" | awk -F 'Vendor=1199 ProdID=90d3' '{print $2}' | cut -c-1100)
if echo "$PVCUT" | grep -q "Driver=qmi_wwan"; then
  PROTO="qmi"
elif echo "$PVCUT" | grep -q "Driver=cdc_mbim"; then
  PROTO="mbim"
elif echo "$PVCUT" | grep -q "Driver=cdc_ether"; then
  PROTO="ecm"
fi

# ✅ In ra JSON hợp lệ
echo "Content-Type: application/json"
echo ""
echo "{"
echo "  \"mode\": \"$(json_safe "$MODE")\","
echo "  \"temp\": \"$(json_safe "$TEMP")\","
echo "  \"rssi\": \"$(json_safe "$RSSI")\","
echo "  \"rsrp\": \"$(json_safe "$RSRP")\","
echo "  \"rsrq\": \"$(json_safe "$RSRQ")\","
echo "  \"sinr\": \"$(json_safe "$SINR")\","
echo "  \"proto\": \"$(json_safe "$PROTO")\","
echo "  \"tac_hex\": \"$(json_safe "$T_HEX")\","
echo "  \"tac_dec\": \"$(json_safe "$T_DEC")\""
echo "}"
